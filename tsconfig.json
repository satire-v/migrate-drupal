{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "lib": ["dom", "esnext"],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "pretty": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "listEmittedFiles": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "lib"
  },
  "include": ["src/**/*"],
  "exclude": ["*/node_modules/**/*"]
}
